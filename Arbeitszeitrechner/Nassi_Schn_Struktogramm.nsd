<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-33" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" includeList="AzubiQuickCheck" namespace="AzubiQuickCheck" author="susi" created="2026-08-10" changed="2026-08-10" origin="Structorizer 3.32-33" text="&#34;main&#34;" comment="&#34;METHOD for class AzubiQuickCheck&#34;,&#34;public static&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;Scanner scanner &#60;- new Scanner(System.in)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;DateTimeFormatter timeFormatter &#60;- DateTimeFormatter.ofPattern(&#34;&#34;HH:mm&#34;&#34;)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;const int tagesSoll &#60;- 462&#34;" comment="" color="ffe0ff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;\n ======= AZUBI TIME-CHECK =======&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;System.out.println(&#34;&#34;\nDas ist ein Arbeitszeitrechner. Anhand der Eingabe des aktuellen und gewÃ¼nschten Zeitkontostandes \nermittelt es die exakte Ausstempelzeit fÃ¼r den jeweiligen Tag. Ideal zum Wochenabschluss.\nNicht ins Minus, aber so frÃ¼h wie mÃ¶glich nach Hause :)&#34;&#34;)&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;\nGrunddaten: 38,5h - 5 Tage die Woche - 7,42h am Tag&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;\nVorgaben:\n- Kernarbeitszeit von 9-15 Uhr. Freitags kannst du frÃ¼her Schluss machen.\n- Stempelzeiten: nur im Zeitraum zwischen 6 Uhr und 18 Uhr erlaubt\n- Pausen: ab 6h-30min, ab 9h-45min und werden automatisch abgezogen und mitberechnet\n- Arbeitszeit: maximal 10h/Tag&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;\nMusterwoche: \nDu baust von Mo-Do tÃ¤glich 30min. Plus auf dein Zeitkonto. Am Freitag hast du dann zwei \nPlusstunden, setzt deine Zielzeit fÃ¼r kommende Woche wieder auf 00:00 und kannst nach \n5 Std. 42 Min. gehen.\n&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;OUTPUT &#34;&#34;LET`S GO!\n&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;LocalTime einstempeln &#60;- null&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;LocalTime minKernzeit &#60;- LocalTime.of(6, 0)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;LocalTime maxKernzeit &#60;- LocalTime.of(9, 0)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<while text="&#34;true&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;OUTPUT &#34;&#34;Einstempelzeit heute eingeben (Format HH:mm, z.B. 07:30): \n&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String eingabeEinstempeln &#60;- scanner.next()&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<try text="&#34;e&#34;" comment="" color="ffffff" disabled="0">
					<qTry>
						<instruction text="&#34;einstempeln &#60;- LocalTime.parse(eingabeEinstempeln, timeFormatter)&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<alternative text="&#34;einstempeln.isBefore(minKernzeit) or einstempeln.isAfter(maxKernzeit)&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;OUTPUT &#34;&#34;\nAchtung-Der Arbeitsbeginn muss in der Kernzeit zwischen 6-9 Uhr liegen. Bitte korrigieren:\n&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
								<instruction text="&#34;continue;&#34;" comment="&#34;Continue statements are NOT SUPPORTED in Structorizer! Try to circumvent it.&#34;" color="ff0000" rotated="0" disabled="1"></instruction>
							</qTrue>
							<qFalse color="ffffff">
							</qFalse>
						</alternative>
						<jump text="" comment="" color="ffffff" disabled="0"></jump>
					</qTry>
					<qCatch>
						<instruction text="&#34;OUTPUT &#34;&#34;\nUngÃ¼ltiges Zeitformat! Bitte um Korrektur:\n&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCatch>
					<qFinally color="ffffff">
					</qFinally>
				</try>
			</qWhile>
		</while>
		<instruction text="&#34;int altesZeitkontoMinuten &#60;- 0&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<while text="&#34;true&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;OUTPUT &#34;&#34;\nBitte aktuellen Stand des Zeitkontos eingeben (Format HH:mm oder -HH:mm, z.B. 02:30 oder -10:15)&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String eingabeAltesZeitkonto &#60;- scanner.next()&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<try text="&#34;e&#34;" comment="" color="ffffff" disabled="0">
					<qTry>
						<alternative text="&#34;eingabeAltesZeitkonto.startsWith(&#34;&#34;-&#34;&#34;)&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;LocalTime zeitAlt &#60;- LocalTime.parse(eingabeAltesZeitkonto.substring(1), timeFormatter)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
								<instruction text="&#34;altesZeitkontoMinuten &#60;- (zeitAlt.getHour() * 60 + zeitAlt.getMinute()) * -1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse>
								<instruction text="&#34;LocalTime zeitAlt &#60;- LocalTime.parse(eingabeAltesZeitkonto, timeFormatter)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
								<instruction text="&#34;altesZeitkontoMinuten &#60;- (zeitAlt.getHour() * 60 + zeitAlt.getMinute())&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qFalse>
						</alternative>
						<jump text="" comment="" color="ffffff" disabled="0"></jump>
					</qTry>
					<qCatch>
						<instruction text="&#34;OUTPUT &#34;&#34;\nUngÃ¼ltige Eingabe, versuche es nochmal mit dem richtigen Zeitformat:&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCatch>
					<qFinally color="ffffff">
					</qFinally>
				</try>
			</qWhile>
		</while>
		<instruction text="&#34;int neuesZeitkontoMinuten &#60;- 0&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<while text="&#34;true&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;OUTPUT &#34;&#34;\nAuf welchen Wert wollen wir dein Zeitkonto bringen? WÃ¤hle etwas zwischen (Format HH:mm, z.B. 00:00 oder 02:00):&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String eingabeZiel &#60;- scanner.next()&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<try text="&#34;e&#34;" comment="" color="ffffff" disabled="0">
					<qTry>
						<instruction text="&#34;LocalTime zeitZiel &#60;- LocalTime.parse(eingabeZiel, timeFormatter)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;neuesZeitkontoMinuten &#60;- zeitZiel.getHour() * 60 + zeitZiel.getMinute()&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<alternative text="&#34;neuesZeitkontoMinuten &#62; 120&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;OUTPUT &#34;&#34;\nLeider darf man als Azubi keine Ãberstunden anhÃ¤ufen, deshalb kannst du nur max. 2 angeben.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse>
								<jump text="" comment="" color="ffffff" disabled="0"></jump>
							</qFalse>
						</alternative>
					</qTry>
					<qCatch>
						<instruction text="&#34;OUTPUT &#34;&#34;UngÃ¼ltige Eingabe, versuche es nochmal mit dem richtigen Format und positiver Zielzeit:&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qCatch>
					<qFinally color="ffffff">
					</qFinally>
				</try>
			</qWhile>
		</while>
		<instruction text="&#34;int nettoArbeitsMinuten &#60;- tagesSoll + neuesZeitkontoMinuten - altesZeitkontoMinuten&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;int pauseMinuten &#60;- 0&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;nettoArbeitsMinuten &#62; 540&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;pauseMinuten &#60;- 45&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse>
				<alternative text="&#34;nettoArbeitsMinuten &#62; 360&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;pauseMinuten &#60;- 30&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<instruction text="&#34;pauseMinuten &#60;- 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qFalse>
				</alternative>
			</qFalse>
		</alternative>
		<instruction text="&#34;LocalTime ausstempeln &#60;- einstempeln.plusMinutes(nettoArbeitsMinuten).plusMinutes(pauseMinuten)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;LocalTime maxFeierabend &#60;- LocalTime.of(18, 0)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;boolean verletzt10Stunden &#60;- nettoArbeitsMinuten &#62; 600&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;boolean verletzt18Uhr &#60;- ausstempeln.isAfter(maxFeierabend)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;verletzt10Stunden or verletzt18Uhr&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;int erlaubtesNetto &#60;- nettoArbeitsMinuten&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;verletzt10Stunden&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;erlaubtesNetto &#60;- Math.min(erlaubtesNetto, 600)&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse color="ffffff">
					</qFalse>
				</alternative>
				<alternative text="&#34;verletzt18Uhr&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;int maxAnwesenheitMinuten &#60;- (int)java.time.Duration.between(einstempeln, maxFeierabend).toMinutes()&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;int angepasstePause &#60;- (maxAnwesenheitMinuten &#62; 585)?45:((maxAnwesenheitMinuten &#62; 390)?30:0)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;int maxNettoBis18 &#60;- maxAnwesenheitMinuten - angepasstePause&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;erlaubtesNetto &#60;- Math.min(erlaubtesNetto, maxNettoBis18)&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse color="ffffff">
					</qFalse>
				</alternative>
				<instruction text="&#34;int finalePause &#60;- (erlaubtesNetto &#62; 540)?45:((erlaubtesNetto &#62; 360)?30:0)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;LocalTime angepasstesAusstempeln &#60;- einstempeln.plusMinutes(erlaubtesNetto).plusMinutes(finalePause)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;int angepasstesZeitkonto &#60;- altesZeitkontoMinuten + erlaubtesNetto - tagesSoll&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;int absMinuten &#60;- abs(angepasstesZeitkonto)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String stundenText &#60;- String.format(&#34;&#34;%02d&#34;&#34;, absMinuten / 60)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String minutenText &#60;- String.format(&#34;&#34;%02d&#34;&#34;, absMinuten mod 60)&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String vorzeichen &#60;- (angepasstesZeitkonto &#60; 0)?&#34;&#34;-&#34;&#34;:&#34;&#34;&#34;&#34;&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;String ausgabeAngepasstesZeitkonto &#60;- vorzeichen + stundenText + &#34;&#34;:&#34;&#34; + minutenText&#34;" comment="" color="e0ffe0" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;verletzt10Stunden and verletzt18Uhr&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;OUTPUT &#34;&#34;\nDu Ã¼berschreitest die maximale Arbeitszeit von 10h UND die 18 Uhr Grenze.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<alternative text="&#34;verletzt10Stunden&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;OUTPUT &#34;&#34;\nÃber 10 Stunden sind nicht erlaubt. Wir sind nicht in Asien!&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse>
								<alternative text="&#34;verletzt18Uhr&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
									<qTrue>
										<instruction text="&#34;OUTPUT &#34;&#34;\nDu erreichst die 18 Uhr Grenze. LÃ¤nger darfst du nicht arbeiten.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
									</qTrue>
									<qFalse color="ffffff">
									</qFalse>
								</alternative>
							</qFalse>
						</alternative>
					</qFalse>
				</alternative>
				<instruction text="&#34;OUTPUT &#34;&#34;SpÃ¤testens um &#34;&#34; + angepasstesAusstempeln + &#34;&#34; Uhr musst du ausstempeln, inkl. &#34;&#34; + finalePause + &#34;&#34; Minuten Pause.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT &#34;&#34;Das angepasste Zeitkonto steht dann auf &#34;&#34; + ausgabeAngepasstesZeitkonto + &#34;&#34;.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;scanner.close()&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<jump text="&#34;return&#34;" comment="" color="ffffff" disabled="0"></jump>
			</qTrue>
			<qFalse color="ffffff">
			</qFalse>
		</alternative>
		<alternative text="&#34;nettoArbeitsMinuten &#62; 540&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;pauseMinuten &#60;- 45&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;OUTPUT &#34;&#34;\nDein Arbeitstag hat entsprechend deiner Auswahl Ã¼ber neun Stunden. Nach Â§4 ArbZG rechne ich dir 45 min. Pause ein.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse>
				<alternative text="&#34;nettoArbeitsMinuten &#62; 360&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;pauseMinuten &#60;- 30&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;OUTPUT &#34;&#34;\nDein Arbeitstag hat entsprechend deiner Auswahl Ã¼ber sechs Stunden. Nach Â§4 ArbZG rechne ich dir 30 min. Pause ein.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<instruction text="&#34;pauseMinuten &#60;- 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
						<instruction text="&#34;OUTPUT &#34;&#34;\nDein Arbeitstag hat entsprechend deiner Auswahl unter sechs Stunden. Nach Â§4 ArbZG rechne ich keine Pause ein.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qFalse>
				</alternative>
			</qFalse>
		</alternative>
		<instruction text="&#34;OUTPUT &#34;&#34;\nAbflug um &#34;&#34; + ausstempeln + &#34;&#34; Uhr.&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;scanner.close()&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>