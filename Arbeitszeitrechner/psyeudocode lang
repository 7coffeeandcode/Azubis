
PROGRAMM AzubiQuickCheck:

    // --- CONSTANTEN & INITIALISIERUNG ---
    KONSTANTE tagesSoll = 462  // 7 Std. 42 Min. in Minuten
    KONSTANTE minKernzeit = 06:00
    KONSTANTE maxKernzeit = 09:00
    KONSTANTE maxFeierabend = 18:00


    // --- 1. EINGABE: EINSTEMPELZEIT ---
    WIEDERHOLE:
        Lese eingabeEinstempeln
        VERSUCHE:
            einstempeln = ParseUhrzeit(eingabeEinstempeln)
            WENN einstempeln < minKernzeit ODER einstempeln > maxKernzeit:
                Ausgabe: "Fehler: Einstempeln muss zwischen 06:00 und 09:00 Uhr liegen!"
                Wiederhole Schleife
            SONST:
                BEENDE SCHLEIFE
        FANGE FEHLER (Ungültiges Format):
            Ausgabe: "Fehler: Ungültiges Zeitformat (HH:mm)!"


    // --- 2. EINGABE: ALTES ZEITKONTO ---
    WIEDERHOLE:
        Lese eingabeAltesZeitkonto
        VERSUCHE:
            WENN eingabeAltesZeitkonto beginnt mit "-":
                zeitAlt = ParseUhrzeit(eingabeAltesZeitkonto ohne "-")
                altesZeitkontoMinuten = (Stunden(zeitAlt) * 60 + Minuten(zeitAlt)) * -1
            SONST:
                zeitAlt = ParseUhrzeit(eingabeAltesZeitkonto)
                altesZeitkontoMinuten = Stunden(zeitAlt) * 60 + Minuten(zeitAlt)
            BEENDE SCHLEIFE
        FANGE FEHLER (Ungültiges Format):
            Ausgabe: "Fehler: Ungültiges Zeitformat!"


    // --- 3. EINGABE: ZIEL-ZEITKONTO ---
    WIEDERHOLE:
        Lese eingabeZiel
        VERSUCHE:
            zeitZiel = ParseUhrzeit(eingabeZiel)
            neuesZeitkontoMinuten = Stunden(zeitZiel) * 60 + Minuten(zeitZiel)
            
            WENN neuesZeitkontoMinuten > 120:
                Ausgabe: "Fehler: Max. 2 Stunden Überstunden erlaubt!"
            SONST:
                BEENDE SCHLEIFE
        FANGE FEHLER (Ungültiges Format):
            Ausgabe: "Fehler: Ungültiges Format oder negativer Wert!"


    // --- 4. BERECHNUNG NETTO-ARBEITSZEIT ---
    nettoArbeitsMinuten = tagesSoll + neuesZeitkontoMinuten - altesZeitkontoMinuten


    // --- 5. PAUSENREGELUNG (§4 ArbZG) ---
    WENN nettoArbeitsMinuten > 540:
        pauseMinuten = 45
    SONST WENN nettoArbeitsMinuten > 360:
        pauseMinuten = 30
    SONST:
        pauseMinuten = 0


    // --- 6. VORLÄUFIGE AUSSTEMPELZEIT ---
    ausstempeln = einstempeln + nettoArbeitsMinuten + pauseMinuten


    // --- 7. GRENZWERT-PRÜFUNG (>10h ODER >18:00 UHR) ---
    verletzt10Stunden = (nettoArbeitsMinuten > 600)
    verletzt18Uhr     = (ausstempeln > maxFeierabend)

    WENN verletzt10Stunden ODER verletzt18Uhr:
        
        erlaubtesNetto = nettoArbeitsMinuten
        
        WENN verletzt10Stunden:
            erlaubtesNetto = Minimum(erlaubtesNetto, 600)
            
        WENN verletzt18Uhr:
            maxAnwesenheitMinuten = Zeitspanne(einstempeln BIS maxFeierabend)
            angepasstePause = BerechnePause(maxAnwesenheitMinuten)
            maxNettoBis18 = maxAnwesenheitMinuten - angepasstePause
            erlaubtesNetto = Minimum(erlaubtesNetto, maxNettoBis18)
            
        finalePause = BerechnePause(erlaubtesNetto)
        angepasstesAusstempeln = einstempeln + erlaubtesNetto + finalePause
        
        // Umstellung der Hauptformel zur Korrektur des Kontos:
        angepasstesZeitkonto = altesZeitkontoMinuten + erlaubtesNetto - tagesSoll
        ausgabeAngepasstesZeitkonto = FormatierteZeit(angepasstesZeitkonto)

        // Textausgabe Warnmeldungen
        WENN verletzt10Stunden UND verletzt18Uhr:
            Ausgabe: "Überschreitung von 10h Arbeitszeit UND 18 Uhr Grenze!"
        SONST WENN verletzt10Stunden:
            Ausgabe: "Über 10 Stunden Arbeitszeit sind nicht erlaubt!"
        SONST WENN verletzt18Uhr:
            Ausgabe: "18 Uhr Grenze erreicht!"

        Ausgabe: "Spätestens ausstempeln um: " + angepasstesAusstempeln
        Ausgabe: "Angepasstes Zeitkonto steht dann auf: " + ausgabeAngepasstesZeitkonto
        
        BEENDE PROGRAMM


    // --- 8. REGULÄRE AUSGABE (Keine Regelverstöße) ---
    WENN nettoArbeitsMinuten > 540:
        Ausgabe: "Arbeitszeit > 9h: 45 min Pause eingerechnet."
    SONST WENN nettoArbeitsMinuten > 360:
        Ausgabe: "Arbeitszeit > 6h: 30 min Pause eingerechnet."
    SONST:
        Ausgabe: "Arbeitszeit < 6h: Keine Pause erforderlich."

    Ausgabe: "Abflug um " + ausstempeln + " Uhr."

ENDE PROGRAMM
